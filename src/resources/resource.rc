#include <windows.h>

// 1. Application Icon (ID 1 makes it the primary default icon in Explorer)
1 ICON "../../assets/icon.ico"

// 2. Application Manifest (RT_MANIFEST = 24, ID = 1)
1 24 "app.manifest"

// 3. Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0" // U.S. English, Unicode
        BEGIN
            VALUE "CompanyName",      "TreeMCP Project\0"
            VALUE "FileDescription",  "TreeMCP - High Speed Disk Space Analyzer & MCP Server\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     "TreeMCP\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 TreeMCP Contributors. MIT License.\0"
            VALUE "OriginalFilename", "TreeMCP.exe\0"
            VALUE "ProductName",      "TreeMCP\0"
            VALUE "ProductVersion",   "1.0.0\0"
            VALUE "Comments",         "Ultra-fast disk space analyzer with Model Context Protocol (MCP) server\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

